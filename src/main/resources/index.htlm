<section id="home" class="hero">
    <div>
        <p class="small-title">WELCOME TO MY PORTFOLIO</p>

        <h1>Hi, I'm <span>Shoaib Ahmed</span></h1>

        <h2>Java Developer & Software Testing Enthusiast</h2>

        <p>
            I am passionate about Java development, web technologies,
            automation testing and building practical projects.
        </p>

        <a href="#projects" class="button">View My Projects</a>
    </div>
</section>

<section id="about">
    <h2>About Me</h2>

    <div class="card">
        <p>
            I am a computer science student interested in software
            development and testing. I work with Java, Selenium,
            TestNG, Gradle, HTML and CSS.
        </p>
    </div>
</section>

<section id="skills">
    <h2>My Skills</h2>

    <div class="skills">
        <div>Java</div>
        <div>HTML</div>
        <div>CSS</div>
        <div>Selenium</div>
        <div>TestNG</div>
        <div>Gradle</div>
        <div>Git & GitHub</div>
    </div>
</section>

<section id="projects">
    <h2>My Projects</h2>

    <div class="projects">

        <div class="card project">
            <h3>Healthcare Chatbot</h3>
            <p>
                Healthcare assistant project designed to help users
